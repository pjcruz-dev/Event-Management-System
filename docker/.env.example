# Copy this file to the project root as `.env.docker`, then edit LAN_HOST.
#
#   copy docker\.env.example .env.docker        (Windows)
#   cp docker/.env.example .env.docker            (Linux/macOS)
#
# Start the stack:
#   docker compose --env-file .env.docker up -d --build
#
# Seed demo data (first time only):
#   docker compose --env-file .env.docker exec backend php artisan db:seed

# --- Required: your PC's LAN IP so colleagues can reach the app ---
# Find it with: ipconfig  (Windows)  or  hostname -I  (Linux)
LAN_HOST=192.168.1.42

# --- Published ports on your PC (colleagues use LAN_HOST + these ports) ---
API_PUBLISH_PORT=8001
FRONTEND_PUBLISH_PORT=3000
MYSQL_PUBLISH_PORT=3306

# --- Laravel ---
APP_NAME="Event SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL container) ---
DB_DATABASE=event_saas
DB_USERNAME=event_saas
DB_PASSWORD=event_saas_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Mail (Mailpit container — web UI at http://<LAN_HOST>:8025) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set true only on first boot to auto-seed (or run db:seed manually)
RUN_SEED=false

# --- Stripe (optional — card checkout) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Mailpit UI ports (when using --profile mail) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
